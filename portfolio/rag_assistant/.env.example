# Скопируйте этот файл в .env и при необходимости поправьте значения.
# .env в git НЕ попадает (там могут быть ключи доступа).

# === LLM: OpenAI-совместимый API ===
# По умолчанию — локальный Ollama (данные не покидают компьютер).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen3:4b
LLM_EMBED_MODEL=bge-m3

# === Вариант: облачный API (лучше качество на русском, нужен ключ) ===
# Раскомментируйте 4 строки и впишите свои значения:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_CHAT_MODEL=gpt-4o-mini
# LLM_EMBED_MODEL=text-embedding-3-small
#
# Или OpenRouter (один ключ — много моделей):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_CHAT_MODEL=openai/gpt-4o-mini
# LLM_EMBED_MODEL=qwen/qwen3-embedding-0.6b

# === Параметры RAG ===
TOP_K=5              # сколько фрагментов подавать модели на вопрос
CHUNK_SIZE=900       # максимальный размер фрагмента, символов
CHUNK_OVERLAP=150    # перекрытие соседних фрагментов, символов
